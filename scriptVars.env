# Shared container paths used across the Image Builder and Buildroot scripts.
BUILDER_ROOT_DIR="/builder/"
WORKSPACE_DIR="/builder/workspace/"
OPENWRT_BUILDER_DIR="/builder/OpenWRT-ImageBuilder/"
BUILDROOT_BUILDER_DIR="/builder/Buildroot-Builder/"
BUILDROOT_CONF_DIR="/builder/buildrootConf/"
BUILDROOT_OUTPUT_DIR="/builder/workspace/output/buildroot/"
OPENWRT_OUTPUT_DIR="/builder/workspace/output/"
USB_INSTALLER_STAGE_DIR="/builder/workspace/output/usb_installer_stage/"
BR_REPO_URL="https://github.com/btbutts/OpenWRT-BuildEnv/"
BR_RELEASE_NAME="OpenWRT-Installer"
BR_CUSTOM_PACKAGE_PATH="/builder/buildrootConf/custom_package"
BR_VERSION_OVERRIDE=""
