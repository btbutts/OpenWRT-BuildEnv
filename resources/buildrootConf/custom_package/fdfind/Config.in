config BR2_PACKAGE_FDFIND
	bool "fdfind"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_USE_MMU
	select BR2_PACKAGE_HOST_RUSTC
	help
	  sharkdp/fd, a user-friendly find alternative. The crate
	  binary is named fd; this package installs it as
	  /usr/bin/fdfind (a real file, not a symlink) so it does
	  not collide with fdclone.

	  Tag 10.5.0 needs rustc >= 1.90.

	  https://github.com/sharkdp/fd

if BR2_PACKAGE_FDFIND

config BR2_PACKAGE_FDFIND_VERSION
	string "fdfind version (GitHub tag without v)"
	default "10.5.0"
	help
	  GitHub tag from sharkdp/fd without the leading v, for
	  example 10.5.0. Leave this unset to use that default.

	  At download time the tag is checked against
	  https://api.github.com/repos/sharkdp/fd/tags
	  An unknown tag fails the build. If fdfind.hash does not
	  yet list that tag's tarball, its sha256 is appended.

endif

comment "fdfind needs host rustc"
	depends on BR2_USE_MMU
	depends on !BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
