config BR2_PACKAGE_DOTNET10
	bool "dotnet10"
	depends on BR2_x86_64 || BR2_aarch64
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_TOOLCHAIN_BUILDROOT
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_WCHAR
	depends on BR2_USE_MMU
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_BROTLI
	select BR2_PACKAGE_ICU
	select BR2_TARGET_TZ_INFO
	select BR2_PACKAGE_LINUX_PAM
	select BR2_PACKAGE_GCC_STANDALONE_TOOLCHAIN
	help
	  Microsoft .NET 10 SDK (precompiled linux-x64 / linux-arm64
	  tarball), extracted to /opt/dotnet10. A login shell gets
	  DOTNET_ROOT=/opt/dotnet10 and that directory appended to
	  PATH from /etc/profile.d/dotnet10.sh.

	  Needs glibc: the Microsoft tarballs are not built for
	  musl or uClibc.

	  Kerberos: libgssapi_krb5 comes from MIT Kerberos, not from
	  Linux-PAM, and .NET loads it lazily for Negotiate/NTLM. This
	  package does not select it. Enable the Buildroot krb5 package
	  yourself if you need those.

	  https://dotnet.microsoft.com/

if BR2_PACKAGE_DOTNET10

config BR2_PACKAGE_DOTNET10_VERSION
	string "dotnet10 SDK version"
	default "10.0.401"
	help
	  .NET SDK version, for example 10.0.401. Downloaded from
	  https://builds.dotnet.microsoft.com/dotnet/Sdk/<version>/
	  Leave this unset to use that default.

	  If dotnet10.hash does not yet list that tarball, its
	  sha256 is appended at download time.

endif

comment "dotnet10 needs an x86-64/aarch64 glibc Buildroot toolchain with C++, threads, wchar and dynamic libs"
	depends on BR2_x86_64 || BR2_aarch64
	depends on !BR2_TOOLCHAIN_USES_GLIBC || !BR2_TOOLCHAIN_BUILDROOT || \
		!BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_USE_WCHAR || BR2_STATIC_LIBS
