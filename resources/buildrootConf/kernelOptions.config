# Notice to developers:
# The Kconfig compiler will treat both
# 'CONFIG_XYZ=n' and '# CONFIG_XYZ is not set
# as a directive to disable the option. To
# comment a param, without it taking effect,
# use '# 'CONFIG_XYZ' or '# 'CONFIG_XYZ=n'
# Enable Linux Kernel USB Support
CONFIG_USB_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_USB_ARCH_HAS_HCD=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_OTG=y

# Support for USB 2.0 (EHCI), USB 3.x (XHCI), and old USB 1.1 (UHCI/OHCI)
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=m
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_PCI=y
CONFIG_HAS_IOPORT=y
CONFIG_USB_UHCI_SUPPORT_NON_PCI_HC=y
CONFIG_HAS_DMA=y
CONFIG_HAS_IOMEM=y
CONFIG_TYPEC=y
CONFIG_USB_ROLE_SWITCH=m

# Optical / installer ISO
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_UDF_FS=y

# SD / eMMC (NUC-class, some boards)
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SPI=m
CONFIG_SDIO_UART=m
CONFIG_USB_ROLES_INTEL_XHCI=m

# Hotplug / enclosures / USB4 docks
CONFIG_PCIEPORTBUS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_ACPI_DOCK=y
CONFIG_USB4=y
CONFIG_USB4_NET=y
CONFIG_THUNDERBOLT=y
CONFIG_INTEL_WMI_THUNDERBOLT=m

# USB serial consoles + UAS already present; add ACM
CONFIG_USB_ACM=y
CONFIG_TTY=y
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_SIMPLE=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP2101=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CONSOLE=y
CONFIG_USB_SERIAL_CYPRESS_M8=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_KEYSPAN=m
CONFIG_USB_SERIAL_KEYSPAN_USA19=y
CONFIG_USB_SERIAL_TI=m
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y
CONFIG_INTEL_WMI_SBL_FW_UPDATE=m

# Misc. USB Drivers
CONFIG_USB_USBIO=m
CONFIG_USB_APPLEDISPLAY=m
CONFIG_USB_CYPRESS_CY7C63=m
CONFIG_USB_LCD=m

# NVMe extras
CONFIG_NVME_CORE=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_HWMON=y
CONFIG_NVME_TARGET=y
CONFIG_NVME_TCP=y
CONFIG_NVME_FC=y

# Input / HID (required for USB keyboards, modifiers, Ctrl+C on VT)
CONFIG_EXPERT=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MISC=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_USB_HIDDEV=y
CONFIG_HOTPLUG=y
CONFIG_HID_MICROSOFT=m
CONFIG_HID_RAZER=m
CONFIG_HID_CORSAIR=m
CONFIG_HID_APPLE=m
CONFIG_INTEL_HID_EVENT=m

# PS/2 Support
