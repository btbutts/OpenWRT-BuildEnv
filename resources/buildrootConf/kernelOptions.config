# Enable Linux Kernel USB Support
CONFIG_USB_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_USB_ARCH_HAS_HCD=y
CONFIG_USB=y
CONFIG_USB_PCI=y

# Support for USB 2.0 (EHCI), USB 3.x (XHCI), and old USB 1.1 (UHCI/OHCI)
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=m
CONFIG_USB_OHCI_HCD=m
CONFIG_HAS_IOPORT=y
CONFIG_USB_UHCI_SUPPORT_NON_PCI_HC=y
CONFIG_HAS_DMA=y
CONFIG_HAS_IOMEM=y

# Input / HID (required for USB keyboards, modifiers, Ctrl+C on VT)
CONFIG_EXPERT=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_USB_HIDDEV=y

# Do not use boot-protocol-only keyboard instead of full HID
# CONFIG_USB_KBD is not set
# CONFIG_USB_MOUSE is not set

# Device nodes in initramfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Map USB storage as a SCSI block device (creates /dev/sdX)
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Core ATA/SATA Framework
CONFIG_ATA=y
CONFIG_BLOCK=y
CONFIG_ATA_VERBOSE_ERROR=y
CONFIG_SATA_PMP=y

# Standard AHCI SATA Controller Driver
CONFIG_SATA_AHCI=y

# Legacy Intel Chipset Fallback
CONFIG_ATA_PIIX=m

# Core SCSI SAS Domain Framework
CONFIG_SCSI_SAS_LIBSAS=y
CONFIG_SCSI_SAS_ATA=y
CONFIG_SCSI_SAS_HOST_SMP=y

# LSI/Broadcom/Avago MegaRAID and MPT SAS Drivers
CONFIG_MEGARAID_MM=y
CONFIG_MEGARAID_NEWGEN=y
CONFIG_MEGARAID_MAILBOX=y
CONFIG_MEGARAID_SAS=y
CONFIG_MEGARAID_LEGACY=y
CONFIG_SCSI_MPT3SAS=y
CONFIG_SCSI_MPT2SAS=y

# Enable Linux Kernel RAID Support
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=y
CONFIG_MD_RAID456=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MD=y

# Filesystem support
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# File systems for your installer USB and the OpenWRT deployment
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Virtual Terminal Graphics Support for iTUI
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_CONSOLE_SLEEP=y
CONFIG_HW_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y

# Graphics DRM Core Stack
CONFIG_DRM=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_BRIDGE=y
CONFIG_PCI=y
CONFIG_MMU=y

# Physical Framebuffer Core and UEFI Fallback
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_SIMPLE=y
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# Open-Source Graphics for Intel, AMD, and Nvidia
# each previously set to =m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_I915=m
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_XE is not set

# No audio on an installer
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_SND_HDA_INTEL is not set
# CONFIG_SND_AC97_CODEC is not set
# CONFIG_SND_USB_AUDIO is not set
# CONFIG_SND_PCM is not set
# CONFIG_SND_TIMER is not set
# CONFIG_SND is not set
# CONFIG_SND_RAWMIDI is not set

# x86_64 Architecture and Kernel Config Options
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_KUNIT=m
CONFIG_INTEL_VSEC=m
CONFIG_PAGE_SIZE_4KB=y

# X86-64 Idle Support
CONFIG_X86_NATIVE_CPU=y
CONFIG_INTEL_IDLE=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_EXPERIMENTAL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI=y

# Virtualization Support
CONFIG_KVM=y
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m

# Enable IOMMU support for virtualization
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y

# UEFI Runtime support
CONFIG_EFI=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_STUB=y
