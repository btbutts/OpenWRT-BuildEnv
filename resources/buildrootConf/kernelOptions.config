# Notice to developers:
# The Kconfig compiler will treat both
# 'CONFIG_XYZ=n' and '# CONFIG_XYZ is not set
# as a directive to disable the option. To
# comment a param, without it taking effect,
# use '# 'CONFIG_XYZ' or '# 'CONFIG_XYZ=n'
# Enable Linux Kernel USB Support
CONFIG_USB_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_USB_ARCH_HAS_HCD=y
CONFIG_USB=y
CONFIG_USB_PCI=y

# Support for USB 2.0 (EHCI), USB 3.x (XHCI), and old USB 1.1 (UHCI/OHCI)
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=m
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_PCI=y
CONFIG_HAS_IOPORT=y
CONFIG_USB_UHCI_SUPPORT_NON_PCI_HC=y
CONFIG_HAS_DMA=y
CONFIG_HAS_IOMEM=y
CONFIG_TYPEC=y
CONFIG_USB_ROLE_SWITCH=m

# Optical / installer ISO
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_UDF_FS=y

# SD / eMMC (NUC-class, some boards)
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MMC_BLOCK=y

# Hotplug / enclosures / USB4 docks
CONFIG_PCIEPORTBUS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_ACPI_DOCK=y
CONFIG_USB4=y
CONFIG_USB4_NET=y
CONFIG_THUNDERBOLT=y

# USB serial consoles + UAS already present; add ACM
CONFIG_USB_ACM=y
CONFIG_TTY=y
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP2101=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CONSOLE=y
CONFIG_USB_SERIAL_CYPRESS_M8=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_KEYSPAN=m
CONFIG_USB_SERIAL_KEYSPAN_USA19=y
CONFIG_USB_SERIAL_TI=m
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y

# NVMe extras
CONFIG_NVME_CORE=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_HWMON=y

# Input / HID (required for USB keyboards, modifiers, Ctrl+C on VT)
CONFIG_EXPERT=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MISC=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_USB_HIDDEV=y
CONFIG_HOTPLUG=y

# PS/2 Support
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_KEYBOARD_ATKBD=y

# Misc Kernel Options
CONFIG_PCI_MSI=y
CONFIG_GNSS=y

# Networking Support
CONFIG_NET=y
CONFIG_NET_CORE=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_ETHERNET=y
CONFIG_NETDEVICES=y
CONFIG_SSB_POSSIBLE=y
CONFIG_ETHTOOL_NETLINK=y
CONFIG_WIREGUARD=y
CONFIG_WIREGUARD_DEBUG=y

# Intel Networking
CONFIG_NET_VENDOR_INTEL=y
CONFIG_NET_VENDOR_I825XX=y
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_I40E=m
CONFIG_ICE=m

# Network vendors
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_REALTEK_PHY=y
CONFIG_REALTEK_PHY_HWMON=y
CONFIG_NET_VENDOR_QUALCOMM=y
CONFIG_NET_VENDOR_NVIDIA=y
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_NET_VENDOR_CAVIUM=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_NET_VENDOR_TI=y
CONFIG_NET_VENDOR_MICROCHIP=y
CONFIG_NET_VENDOR_XILINX=y
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_NET_VENDOR_BROCADE=y
CONFIG_NET_VENDOR_CISCO=y
CONFIG_NET_VENDOR_CHELSIO=y
CONFIG_NET_VENDOR_CISCO=y
CONFIG_NET_VENDOR_AQUANTIA=y

# Generic Network Drivers
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_TIGON3=m
CONFIG_BNXT=m

# USB Networking
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8150=m
CONFIG_USB_RTL8152=m
CONFIG_USB_RTL8153_ECM=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_LAN78XX=m
CONFIG_USB_IPHETH=y
CONFIG_USB_SIERRA_NET=m
CONFIG_USB_NET_AQC111=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_CDC_SUBSET=m
CONFIG_USB_NET_CDC_SUBSET_ENABLE=m
CONFIG_USB_NET_CDC_EEM=m

# PTP and Timing
CONFIG_PTP_1588_CLOCK_OPTIONAL=m
CONFIG_PTP_1588_CLOCK=m
CONFIG_POSIX_TIMERS=y

# Do not use boot-protocol-only keyboard instead of full HID
# CONFIG_USB_KBD=n
# CONFIG_USB_MOUSE=n

# Device nodes in initramfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# External zstd CPIO (not built-in INITRAMFS)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y

# Allow Kernel Load External Modules
CONFIG_MODULES=y
CONFIG_SMP=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_BINFMT_MISC=y
CONFIG_FW_LOADER=y
CONFIG_FIRMWARE_IN_KERNEL=y
CONFIG_EXTRA_FIRMWARE=""
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_INOTIFY_USER=y
CONFIG_UNIX=y

# HW Monitoring
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_IT87=m
CONFIG_SENSORS_NCT6775=m
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_ACPI_THERMAL=m
CONFIG_ACPI_BUTTON=m
CONFIG_HW_RANDOM=m
CONFIG_HW_RANDOM_AMD=m
CONFIG_HW_RANDOM_INTEL=m

# Confirm fragment actually landed
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Map USB storage as a SCSI block device
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_HPSA=m
CONFIG_SCSI_SMARTPQI=m
CONFIG_SCSI_AACRAID=m
CONFIG_VMWARE_PVSCSI=m
CONFIG_FUSION=y
CONFIG_FUSION_SAS=y

# Core ATA/SATA Framework
CONFIG_ATA=y
CONFIG_BLOCK=y
CONFIG_ATA_VERBOSE_ERROR=y
CONFIG_SATA_PMP=y

# Standard AHCI SATA Controller Driver
CONFIG_SATA_AHCI=y

# Common SATA beyond generic AHCI (leave as =m)
CONFIG_SATA_NV=m
CONFIG_SATA_SIL=m
CONFIG_SATA_SIL24=m
CONFIG_SATA_VIA=m
CONFIG_SATA_SIS=m
CONFIG_SATA_SVW=m
CONFIG_SATA_ACARD_AHCI=m
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_GENERIC=y

# Legacy Intel Chipset Fallback
CONFIG_ATA_PIIX=m

# Core SCSI SAS Domain Framework
CONFIG_SCSI_SAS_LIBSAS=y
CONFIG_SCSI_SAS_ATA=y
CONFIG_SCSI_SAS_HOST_SMP=y

# LSI/Broadcom/Avago MegaRAID and MPT SAS Drivers
CONFIG_MEGARAID_MM=y
CONFIG_MEGARAID_NEWGEN=y
CONFIG_MEGARAID_MAILBOX=y
CONFIG_MEGARAID_SAS=y
CONFIG_MEGARAID_LEGACY=y
CONFIG_SCSI_MPT3SAS=y
CONFIG_SCSI_MPT2SAS=y

# Enable Linux Kernel RAID Support
CONFIG_BLK_DEV_MD=y
CONFIG_MD_AUTODETECT=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=y
CONFIG_MD_RAID456=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MD=y

# Block Device Stack
CONFIG_BLK_DEV_INTEGRITY=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_NBD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_MIRROR=y
CONFIG_DM_RAID=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_UEVENT=y
CONFIG_BLK_DEV_BSG=y
CONFIG_SCSI=y
CONFIG_SCSI_FC_ATTRS=y
CONFIG_SCSI_CONSTANTS=y
CONFIG_CHR_DEV_SG=y

# Filesystem support
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# File systems Support
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y
CONFIG_F2FS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FS_ENCRYPTION=y
CONFIG_BTRFS_FS_POSIX_ACL=y

# Crypto Support
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_CRC32C_INTEL=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_TRUSTED_KEYS=y

# Virtual Terminal Graphics Support for iTUI
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_CONSOLE_SLEEP=y
CONFIG_HW_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y

# Graphics DRM Core Stack
CONFIG_DRM=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_BRIDGE=y
CONFIG_PCI=y
CONFIG_MMU=y
# Added 23SEP when adding EUDEV
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_CLIENT_SELECTION=y

# Physical Framebuffer Core and UEFI Fallback
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_SIMPLE=y
# CONFIG_DRM_SIMPLEDRM
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# Added 23SEP when adding EUDEV
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y

# Console support
CONFIG_EARLY_PRINTK=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_EARLY_PRINTK_EFI=y
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y

# Serial Support
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_SERIAL_8250_NR_UARTS=32
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_DRM_FBDEV_EMULATION=y

# I2C Support
CONFIG_I2C=y
CONFIG_I2C_I801=m
CONFIG_I2C_PIIX4=m

# Open-Source Graphics for Intel, AMD, and Nvidia
# each previously set to =m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_I915=m
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y
CONFIG_MICROCODE_AMD=y
CONFIG_AMD_NODE=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_XE=m

# AMD and Radeon GPU Options
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_FP=y

# No audio on an installer
# CONFIG_SOUND
# CONFIG_SND
# CONFIG_SND_HDA_INTEL
# CONFIG_SND_AC97_CODEC
# CONFIG_SND_USB_AUDIO
# CONFIG_SND_PCM
# CONFIG_SND_TIMER
# CONFIG_SND
# CONFIG_SND_RAWMIDI

# x86_64 Architecture and Kernel Config Options
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_KUNIT=m
CONFIG_INTEL_VSEC=m
CONFIG_X86_LOCAL_APIC=y
CONFIG_PAGE_SIZE_4KB=y
CONFIG_PAGE_SIZE_LESS_THAN_256KB=y
CONFIG_PAGE_SIZE_LESS_THAN_64KB=y

# X86-64 Idle Support
CONFIG_X86_NATIVE_CPU=y
CONFIG_INTEL_IDLE=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_EXPERIMENTAL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_PM=y

# Virtualization Support
CONFIG_KVM=y
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m

# Enable IOMMU support for virtualization
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y

# UEFI Runtime support
CONFIG_EFI=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS_PSTORE=y
CONFIG_PSTORE=y
CONFIG_EFI_BOOTLOADER_CONTROL=y
CONFIG_EFI_CAPSULE_LOADER=y
CONFIG_EFI_ESRT=y
CONFIG_EFI_SOFT_RESERVE=y
CONFIG_EFI_RUNTIME_MAP=y
CONFIG_EFI_RUNTIME_WRAPPERS=y
CONFIG_EFI_MIXED=y

# Hypervisor Support
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_HAVE_STATIC_CALL=y
CONFIG_VMXNET3=m
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_VMBUS=m
CONFIG_HYPERV_NET=m
CONFIG_XEN=y
CONFIG_XEN_BLKDEV_FRONTEND=y
CONFIG_XEN_BLKDEV_BACKEND=y
CONFIG_XEN_NETDEV_FRONTEND=m
CONFIG_XEN_NETDEV_BACKEND=m
