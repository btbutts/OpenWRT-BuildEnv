# Added 23SEP when adding EUDEV support
# Async Operation
# BR2_PACKAGE_EUDEV is not set
# BR2_PACKAGE_HOST_EUDEV is not set
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_HOST_KMOD=y
# BR2_PACKAGE_EUDEV_ENABLE_HWDB is not set
# BR2_PACKAGE_EUDEV_MODULE_LOADING is not set
# eudev is managed by systemd when systemd enabled 01OCT
BR2_PACKAGE_PROVIDES_LIBUDEV="systemd"
BR2_PACKAGE_PROVIDES_UDEV="systemd"

# DBUS
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_DBUS_BROKER=y
BR2_PACKAGE_DBUS_CPP=y

# Linux Kernel Build Engine Instructions
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_ZSTD=y

# Critical Kernel RAID Driver Compilation Directives
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(TOPDIR)/kernelOptions.config"

# Linux Firmware Packages
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RADEON=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y
BR2_PACKAGE_LINUX_FIRMWARE_XE=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_LINUX_FIRMWARE_AMD_UCODE=y
BR2_PACKAGE_INTEL_MICROCODE=y
BR2_PACKAGE_INTEL_MICROCODE_INSTALL_TARGET=y
# BR2_PACKAGE_IUCODE_TOOL=n

# System Configuration
BR2_TARGET_GENERIC_HOSTNAME="OpenWRT-Installer"
BR2_TARGET_GENERIC_ISSUE="Welcome to the OpenWRT RAID Installer"
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_SYSTEM_BIN_SH_BASH=y
BR2_SYSTEM_BIN_SH="bash"
BR2_PACKAGE_MINICOM=y
BR2_ROOTFS_MERGED_USR=y
BR2_ROOTFS_MERGED_BIN=y
# Added 23SEP when adding EUDEV support
# DEVTMPFS is disabled intentionally for EUDEV
# BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=n
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# Custom Options
BR2_KEEP_MAN_PAGES_DOCS=y
BR2_PACKAGE_GROFF=y
BR2_PACKAGE_GROFF_VERSION="1.24.2"
BR2_PACKAGE_GCC_STANDALONE_TOOLCHAIN=y
BR2_PACKAGE_GCC_STANDALONE_TOOLCHAIN_VERSION="2026.08-1"
