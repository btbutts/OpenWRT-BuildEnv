# Platform toggle: set to 'other' (for macOS/Windows) or 'linux'
HOST_OS=other

# OpenWRT Container Config Vars
HOST_INTERFACE=eth0
LAN_SUBNET=192.168.0.0/23
LAN_GATEWAY=192.168.0.1
MACVLAN_IP_RANGE=192.168.0.40/30
#EXCLUDED_IP_1=
TARGET_PLATFORM=linux/amd64
BRIDGE_SUBNET=172.25.25.0/26
BRIDGE_GATEWAY=172.25.25.1
CONTAINER_IP=172.25.25.10
